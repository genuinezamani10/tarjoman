# ─── پیکربندی ترجمان (نسخهٔ مستقل با API) ───
# این فایل را کپی کنید و اسمش را .env بگذارید، بعد مقادیر را پر کنید.

# کلید API شما (از همان سرویسی که پایین انتخاب می‌کنید)
TARJOMAN_API_KEY=

# آدرس پایهٔ سرویس — هر سرویس سازگار با OpenAI می‌شود:
#   OpenRouter : https://openrouter.ai/api/v1
#   OpenAI     : https://api.openai.com/v1
#   Gemini     : https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama لوکال: http://localhost:11434/v1   (کلید لازم ندارد؛ هر رشته‌ای بنویسید)
TARJOMAN_BASE_URL=https://openrouter.ai/api/v1

# مدل پیش‌فرض برای همهٔ حالت‌ها (نمونه‌های OpenRouter):
#   ارزان و خوب برای مقاله/درسی: google/gemini-2.5-flash
#   قوی‌تر برای رمان: anthropic/claude-sonnet-4.5
TARJOMAN_MODEL=google/gemini-2.5-flash

# اگر خواستید برای هر حالت مدل جدا بدهید (اختیاری):
# TARJOMAN_MODEL_ARTICLE=
# TARJOMAN_MODEL_TEXTBOOK=
# TARJOMAN_MODEL_NOVEL=anthropic/claude-sonnet-4.5
